#!/bin/sh
set -e

# Build env
if [ -z "$BUILD" ]; then
	BUILD=$HOME/build
fi
mkdir -p $BUILD
cd $BUILD

# Install prefix
if [ -z "$PREFIX" ]; then
	PREFIX=$HOME/.local
fi

vim_version=$1

# Download the latest source if vim_version is not specified
if [ -z "$vim_version" ]; then
	vim_version=$(curl "https://api.github.com/repos/vim/vim/tags?per_page=1" | grep '"name":' | cut -d'"' -f4)
fi

# Download source
vim_tarball_url="https://api.github.com/repos/vim/vim/tarball/refs/tags/$vim_version"
curl -L -o vim-$vim_version.tar.gz $vim_tarball_url
tar -xf vim-$vim_version.tar.gz

vimdir=$(tar -tf vim-$vim_version.tar.gz | head -n1 | cut -d/ -f1)
cd $vimdir

# Configure
./configure \
	--prefix=$PREFIX \
	--without-x \
	--disable-gui \
	--disable-canberra \
	--disable-netbeans \
	--enable-multibyte \
	--enable-terminal \
	--enable-python3interp=dynamic \
	--enable-luainterp=dynamic \
	--with-luajit

# Build
make -j$(nproc)

# Install
make install
